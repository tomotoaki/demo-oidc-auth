{
  "realm": "demo",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "ssoSessionIdleTimeout": 300,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 60,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "管理者ロール - スイッチユーザー権限を持つ"
      },
      {
        "name": "USER",
        "description": "一般ユーザーロール"
      }
    ],
    "client": {
      "demo-oidc-auth-server": [
        {
          "name": "doctor",
          "description": "Doctor Role"
        },
        {
          "name": "staff",
          "description": "Staff Role"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "medical-institution",
      "path": "/medical-institution",
      "subGroups": []
    },
    {
      "name": "non-medical-institution",
      "path": "/non-medical-institution",
      "subGroups": []
    }
  ],
  "clients": [
    {
      "clientId": "demo-oidc-auth-client-bff",
      "name": "demo-oidc-auth-client-bff",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-oidc-auth-client-bff-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:8080/api/v2/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/login",
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "true",
            "usermodel.clientRoleMapping.clientId": "demo-oidc-auth-server"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "demo-oidc-auth-mobile-bff",
      "name": "demo-oidc-auth-mobile-bff",
      "description": "Spring Boot BFF for smartphone/tablet app access",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-oidc-auth-mobile-bff-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:8081/mobile-bff/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8081"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8081/mobile-bff/*",
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-demo-oidc-auth-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "demo-oidc-auth-server",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "true",
            "usermodel.clientRoleMapping.clientId": "demo-oidc-auth-server"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "demo-oidc-auth-server",
      "name": "demo-oidc-auth-server",
      "description": "Audience client for the resource server API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "medical-institution-doctor",
      "email": "doctor-medical@example.com",
      "firstName": "Doctor",
      "lastName": "MedicalInstitution",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ],
      "groups": [
        "/medical-institution"
      ],
      "clientRoles": {
        "demo-oidc-auth-server": [
          "doctor"
        ]
      }
    },
    {
      "username": "medical-institution-staff",
      "email": "staff-medical@example.com",
      "firstName": "Staff",
      "lastName": "MedicalInstitution",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ],
      "groups": [
        "/medical-institution"
      ],
      "clientRoles": {
        "demo-oidc-auth-server": [
          "staff"
        ]
      }
    },
    {
      "username": "non-medical-institution-doctor",
      "email": "doctor-nonmedical@example.com",
      "firstName": "Doctor",
      "lastName": "NonMedicalInstitution",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ],
      "groups": [
        "/non-medical-institution"
      ],
      "clientRoles": {
        "demo-oidc-auth-server": [
          "doctor"
        ]
      }
    },
    {
      "username": "non-medical-institution-staff",
      "email": "staff-nonmedical@example.com",
      "firstName": "Staff",
      "lastName": "NonMedicalInstitution",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ],
      "groups": [
        "/non-medical-institution"
      ],
      "clientRoles": {
        "demo-oidc-auth-server": [
          "staff"
        ]
      }
    }
  ]
}